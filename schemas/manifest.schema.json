{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliyun-oss.yaklang.com/browsers/chrome/manifest.schema.json",
  "title": "Chrome for Testing OSS mirror manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "channel", "generated_at", "source", "max_versions", "latest", "versions"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"const": "chrome-for-testing"},
    "channel": {"const": "stable"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "manifest_url"],
      "properties": {
        "name": {"const": "Google Chrome for Testing"},
        "manifest_url": {"const": "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json"}
      }
    },
    "max_versions": {"type": "integer", "minimum": 1},
    "latest": {"$ref": "#/$defs/version"},
    "versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/release"}
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "channel", "mirrored_at", "artifacts"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "revision": {"type": "string", "pattern": "^[0-9]+$"},
        "channel": {"const": "stable"},
        "mirrored_at": {"type": "string", "format": "date-time"},
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "format", "filename", "url", "checksum_url", "sha256", "size", "source_url", "signature"],
      "properties": {
        "os": {"enum": ["macos", "windows", "linux"]},
        "arch": {"enum": ["arm64", "x64"]},
        "format": {"const": "zip"},
        "filename": {"type": "string", "pattern": "^chrome-cft-[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+-(macos-(arm64|x64)|windows-x64|linux-x64)\\.zip$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "checksum_url": {"type": "string", "format": "uri", "pattern": "\\.zip\\.sha256\\.txt$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://storage\\.googleapis\\.com/chrome-for-testing-public/"},
        "signature": {"type": "null"}
      }
    }
  }
}
